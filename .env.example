# Copy to .env. Directory on the host that holds your videos:
ARGENTUM_MEDIA_HOST_DIR=/path/to/family/videos
ARGENTUM_PORT=4567
# Seconds between rescans of the media folder (0 = startup and manual only).
ARGENTUM_SCAN_INTERVAL=60
# A file is processed once it has been untouched this many seconds, so videos still
# being copied in (e.g. over LocalSend) aren't processed half-written.
ARGENTUM_SETTLE_SECONDS=20
# Codec/filter threads per FFmpeg operation; 1 keeps small machines responsive.
ARGENTUM_FFMPEG_THREADS=1

# ---- Branding ----
# Site name shown in the header and browser tab.
ARGENTUM_TITLE=argentum
# Small line under the title; leave empty to hide it.
ARGENTUM_TAGLINE=family video library
# Logo: an http(s) URL, or a path to an image *inside the container*. The media
# folder is mounted at /media, so the easiest option is to drop a file there:
#   ARGENTUM_LOGO=/media/logo.png
# Leave empty for the built-in icon, or "none" for no logo.
ARGENTUM_LOGO=
# Initial theme: dark, light or system. Viewers can toggle; their choice is remembered.
ARGENTUM_THEME=dark
