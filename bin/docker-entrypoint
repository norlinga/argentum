#!/bin/sh
# Production entrypoint. Starts as root only long enough to make sure the data
# volume belongs to the unprivileged "argentum" user (volumes created by earlier,
# root-run images don't), then drops privileges for good before exec'ing the app.
set -eu

if [ "$(id -u)" = 0 ]; then
  data=${ARGENTUM_DATA_DIR:-/data}
  mkdir -p "$data"
  # Stops at the first file not owned by argentum, so a migrated volume costs one walk.
  if [ -n "$(find "$data" ! -user argentum -print -quit)" ]; then
    echo "argentum: handing $data to user argentum (one-time upgrade from a root-run image)" >&2
    chown -R argentum:argentum "$data"
  fi
  export HOME=/home/argentum
  exec setpriv --reuid=argentum --regid=argentum --init-groups -- "$@"
fi

exec "$@" # already unprivileged, e.g. `docker run --user …`
